<Window x:Class="FlashLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlashLock"
        Width="600"
        Height="700"
        MinWidth="560"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="18" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="FlashLock" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="Portable USB write protection" FontSize="15" Opacity="0.7" />
        </StackPanel>

        <Border Grid.Row="2" Padding="20" CornerRadius="12" BorderBrush="#33000000" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DriveNameText" Text="Detecting drive..." FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DriveDetailsText" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock x:Name="DriveIdentityText" Margin="0,4,0,0" Opacity="0.55" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CompatibilityIcon" Text="…" FontSize="30" VerticalAlignment="Center" Margin="20,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="20" CornerRadius="12" BorderBrush="#33000000" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Protection status" FontSize="14" Opacity="0.7" />
                <TextBlock x:Name="StatusText" Text="CHECKING" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                <TextBlock x:Name="StatusDescriptionText" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6">
            <TextBlock Text="When protected" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0" Text="✓ Open and read files" />
            <TextBlock Margin="0,8,0,0" Text="✓ Copy files from USB to another drive" />
            <TextBlock Margin="0,8,0,0" Text="✕ Delete or rename files" />
            <TextBlock Margin="0,8,0,0" Text="✕ Modify or overwrite content" />
            <TextBlock Margin="0,8,0,0" Text="✕ Add new files or folders" />
            <TextBlock Margin="0,20,0,0" Opacity="0.65" TextWrapping="Wrap"
                       Text="FlashLock v0.1 uses NTFS ACLs and is designed for accidental/normal-user write protection. A Windows administrator can deliberately override filesystem permissions." />
            <TextBlock x:Name="OperationText" Margin="0,18,0,0" TextWrapping="Wrap" FontWeight="SemiBold" />
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RecoveryButton" Width="130" Height="46" Margin="0,0,10,0" Content="Recover" Click="RecoveryButton_Click" Visibility="Collapsed" />
            <Button x:Name="PrimaryButton" Width="170" Height="46" Content="Protect drive" Click="PrimaryButton_Click" IsEnabled="False" />
        </StackPanel>
    </Grid>
</Window>
