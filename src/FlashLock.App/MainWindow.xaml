<Window x:Class="FlashLock.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FlashLock"
        Width="560"
        Height="620"
        MinWidth="520"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="24" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="FlashLock" FontSize="34" FontWeight="SemiBold" />
            <TextBlock Text="Portable USB write protection" FontSize="15" Opacity="0.7" />
        </StackPanel>

        <Border Grid.Row="2" Padding="20" CornerRadius="12" BorderBrush="#33000000" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DriveNameText" Text="Detecting drive..." FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="DriveDetailsText" Margin="0,6,0,0" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="CompatibilityIcon" Text="…" FontSize="30" VerticalAlignment="Center" Margin="20,0,0,0" />
            </Grid>
        </Border>

        <Border Grid.Row="4" Padding="20" CornerRadius="12" BorderBrush="#33000000" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Protection status" FontSize="14" Opacity="0.7" />
                <TextBlock x:Name="StatusText" Text="FOUNDATION MODE" FontSize="24" FontWeight="Bold" Margin="0,6,0,0" />
                <TextBlock x:Name="StatusDescriptionText" Margin="0,10,0,0" TextWrapping="Wrap"
                           Text="Drive mutation is intentionally disabled until the ACL experiment is validated." />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="6">
            <TextBlock Text="Planned protected behavior" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0" Text="✓ Open and read files" />
            <TextBlock Margin="0,8,0,0" Text="✓ Copy files from USB" />
            <TextBlock Margin="0,8,0,0" Text="✕ Delete or rename files" />
            <TextBlock Margin="0,8,0,0" Text="✕ Modify or overwrite content" />
            <TextBlock Margin="0,8,0,0" Text="✕ Add new files or folders" />
            <TextBlock Margin="0,20,0,0" Opacity="0.65" TextWrapping="Wrap"
                       Text="FlashLock v1 targets Windows 10/11 and NTFS. Administrator-level bypass is outside the v1 threat model." />
        </StackPanel>

        <Button Grid.Row="7" Height="48" Content="Protection engine unlocks in FL-004" IsEnabled="False" />
    </Grid>
</Window>
